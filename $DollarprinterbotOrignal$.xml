<robot>
  <variables>
    <var name="base_stake" type="double" value="1"/>
    <var name="stake" type="double" value="1"/>
    <var name="profit_target" type="double" value="10"/>
    <var name="loss_limit" type="double" value="8"/>
    <var name="multiplier" type="double" value="1.6"/>
  </variables>

  <blocks>
    <!-- Stop conditions -->
    <stop>
      <condition type="or">
        <condition1 type="profit" value="profit_target"/>
        <condition2 type="loss" value="loss_limit"/>
      </condition>
    </stop>

    <!-- Trade block -->
    <trade>
      <market>volidx100</market>
      <contract>
        <type>DIGITOVER</type>
        <duration>1</duration>
        <prediction>7</prediction>
      </contract>

      <stake>
        <value>stake</value>
      </stake>

      <after>
        <condition result="win">
          <assign var="stake" value="base_stake"/>
        </condition>

        <condition result="loss">
          <assign var="stake" value="stake * multiplier"/>
        </condition>
      </after>
    </trade>
  </blocks>
</robot>
