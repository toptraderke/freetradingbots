                      <block type="variables_get">
                        <field name="VAR" id="rP]rJTAeSthDOPA8=l%8">Stake</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number">
                        <field name="NUM">2</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
