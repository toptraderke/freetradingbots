            <field name="VAR" id="winCount">winCount</field>
            <value name="VALUE">
              <block type="math_arithmetic">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR" id="winCount">winCount</field>
                  </block>
                </value>
